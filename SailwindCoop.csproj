<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sailwind LAN Co-op — BepInEx plugin.
    Targets net46 (Unity 2019 Mono / .NET 4.x). Builds straight into the game's
    BepInEx/plugins/SailwindCoop folder. See DESIGN.md.
  -->
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>SailwindCoop</AssemblyName>
    <RootNamespace>SailwindCoop</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>

    <!-- Absolute paths to the installed game. Adjust GameDir if the game moves. -->
    <GameDir>D:\SteamLibrary\steamapps\common\Sailwind</GameDir>
    <ManagedDir>$(GameDir)\Sailwind_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <PluginDir>$(GameDir)\BepInEx\plugins\SailwindCoop</PluginDir>

    <!-- Drop the build output directly into the plugin folder. -->
    <OutputPath>$(PluginDir)\</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!--
      Two editions from one source tree:
        Full         (default)  the Steam transport and mod download from the host; published outside
                                Thunderstore. Builds into the game's plugin folder.
        Thunderstore            neither of them: no Steam library is referenced or shipped, and no
                                code that sends, receives or installs mod files is compiled.
                                dotnet build SailwindCoop.csproj -c Release -p:Edition=Thunderstore
                                Builds into bin\Thunderstore\.
      Both speak the same protocol and can play together.
    -->
    <Edition Condition="'$(Edition)'==''">Full</Edition>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Edition)'=='Thunderstore'">
    <DefineConstants>$(DefineConstants);THUNDERSTORE</DefineConstants>
    <OutputPath>$(MSBuildProjectDirectory)\bin\Thunderstore\</OutputPath>
    <IntermediateOutputPath>obj\Thunderstore\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Edition)'=='Thunderstore'">
    <Compile Remove="Net\SteamLink.cs" />
    <Compile Remove="Sync\ModSync.Download.cs" />
    <Compile Remove="Sync\ModTransfer.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Edition)'!='Thunderstore'">
    <Compile Remove="Net\SteamLinkStub.cs" />
    <Compile Remove="Sync\ModSync.NoDownload.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- BCL reference assemblies so net46 builds without the targeting pack installed.
         Compile-time only; never shipped (Unity provides the runtime BCL). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx + Harmony (do not copy: provided by the loader). -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- netstandard facade: the netstandard2.0 LiteNetLib surfaces types through it.
         Provided by Unity Mono at runtime, so do not copy. -->
    <Reference Include="netstandard">
      <HintPath>$(ManagedDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Transport. Copied next to the plugin DLL (Private=true). -->
    <Reference Include="LiteNetLib">
      <HintPath>$(MSBuildProjectDirectory)\libs\LiteNetLib.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!-- Steam transport: the managed wrapper, copied next to the plugin DLL. Its native half
         (steam_api64.dll) is copied below; the game ships no Steam library of its own. -->
    <Reference Include="Facepunch.Steamworks.Win64" Condition="'$(Edition)'!='Thunderstore'">
      <HintPath>$(MSBuildProjectDirectory)\libs\Facepunch.Steamworks.Win64.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!-- Game + Unity (do not copy: provided by the game). -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Crest is the ocean the game actually renders and floats on (the legacy `Ocean` class in
         Assembly-CSharp is dead code — Ocean.Singleton is null at runtime). -->
    <Reference Include="Crest">
      <HintPath>$(ManagedDir)\Crest.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Valve's binary (not MIT). Kept in git so the full edition builds out of the box; it is not
         copied into, and must not be packed with, the Thunderstore edition. -->
    <None Include="libs\steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="'$(Edition)'!='Thunderstore'" />
    <!-- Emote voice lines, loaded at runtime from the "sounds" folder next to the plugin DLL. -->
    <None Include="Sounds\landho.wav" Link="sounds\landho.wav" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    The netstandard2.0 LiteNetLib drags BCL facade shims into the output. Unity Mono
    provides those at runtime; shipping them into BepInEx/plugins can cause assembly
    load conflicts. Strip everything except our DLL + LiteNetLib after each build.
  -->
  <Target Name="StripFacades" AfterTargets="Build">
    <ItemGroup>
      <_Keep Include="$(OutputPath)SailwindCoop.dll" />
      <_Keep Include="$(OutputPath)SailwindCoop.pdb" />
      <_Keep Include="$(OutputPath)LiteNetLib.dll" />
      <_Keep Include="$(OutputPath)Facepunch.Steamworks.Win64.dll" />
      <_Keep Include="$(OutputPath)steam_api64.dll" />
      <_AllDlls Include="$(OutputPath)*.dll" />
      <_Strip Include="@(_AllDlls)" Exclude="@(_Keep)" />
    </ItemGroup>
    <Delete Files="@(_Strip)" />
  </Target>

</Project>
