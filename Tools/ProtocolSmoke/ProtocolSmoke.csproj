<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net46</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <GameDir>D:\SteamLibrary\steamapps\common\Sailwind</GameDir>
    <ManagedDir>$(GameDir)\Sailwind_Data\Managed</ManagedDir>
    <DefineConstants>$(DefineConstants);PROTOCOL_SMOKE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Net\BoatGenerationQueue.cs" Link="Net\BoatGenerationQueue.cs" />
    <Compile Include="..\..\Net\BoatGenerationBook.cs" Link="Net\BoatGenerationBook.cs" />
    <Compile Include="..\..\Net\RefitMessages.cs" Link="Net\RefitMessages.cs" />
    <Compile Include="..\..\Net\ItemDetails.cs" Link="Net\ItemDetails.cs" />
    <Compile Include="..\..\Net\ChartMessages.cs" Link="Net\ChartMessages.cs" />
    <Compile Include="..\..\Net\DirtMessages.cs" Link="Net\DirtMessages.cs" />
    <Compile Include="..\..\Net\OrbMessages.cs" Link="Net\OrbMessages.cs" />
    <Compile Include="..\..\Net\InstrumentMessages.cs" Link="Net\InstrumentMessages.cs" />
    <Compile Include="..\..\Net\ItemOperationMessages.cs" Link="Net\ItemOperationMessages.cs" />
    <Compile Include="..\..\Net\Messages.cs" Link="Net\Messages.cs" />
    <Compile Include="..\..\Net\DiceMessages.cs" Link="Net\DiceMessages.cs" />
    <Compile Include="..\..\Net\ModManifest.cs" Link="Net\ModManifest.cs" />
    <Compile Include="..\..\Net\ModMessages.cs" Link="Net\ModMessages.cs" />
    <Compile Include="..\..\Net\Protocol.cs" Link="Net\Protocol.cs" />
    <Compile Include="..\..\Net\MessageDirection.cs" Link="Net\MessageDirection.cs" />
    <Compile Include="..\..\Net\NetRegistry.cs" Link="Net\NetRegistry.cs" />
    <Compile Include="..\..\Sync\SleepTransitionState.cs" Link="Sync\SleepTransitionState.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LiteNetLib">
      <HintPath>..\..\libs\LiteNetLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(ManagedDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
